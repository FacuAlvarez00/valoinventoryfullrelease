PORT=4000
NODE_ENV=development

# CORS: origen permitido del frontend
FRONTEND_ORIGIN=http://localhost:3000

# Mongo local (levantado por docker-compose). Si usás Atlas, reemplazá por tu connection string.
MONGODB_URI=mongodb://mongo:27017/valoinventory

JWT_SECRET=changeme-local-dev-secret
JWT_EXPIRES_IN=7d

# Opcional: API key de HenrikDev para el lookup de nivel de cuenta (https://docs.henrikdev.xyz)
HENRIKDEV_API_KEY=
